# Sagarvani Reconstructed — Environment Configuration Template
# NOTE: Never put real credentials, API keys, or private phone numbers in this file or commit .env to source control!

# Server Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Open-Meteo (Free, attribution required, no API key needed for standard non-commercial use)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# Optional Feeds & Services (Requires institutional/service account access)
IMD_API_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Feature Flags
ENABLE_LAYA_SELECTOR=false
ENABLE_MOCK_GATEWAYS=true
ENABLE_EXTERNAL_DISPATCH=false
