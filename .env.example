# =============================================================================
# Sagarvani Reconstructed — Environment Variables (EXAMPLE / PLACEHOLDERS ONLY)
#
# Copy this file to the correct locations:
#   Frontend → frontend/.env.local
#   Backend  → backend/.env
#
# NEVER commit .env or .env.local files; they are in .gitignore.
# NEVER put SUPABASE_SECRET_KEY in any NEXT_PUBLIC_ variable.
# =============================================================================

# ---------------------------------------------------------------------------
# Frontend (Next.js) — frontend/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY_HERE

# URL of the running FastAPI backend (localhost for development)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend (FastAPI / uv) — backend/.env
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY_HERE
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY_HERE
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Feature flag: set to true to require authentication on every /api/orca/query call
REQUIRE_QUERY_AUTH=false

# Path to the SQLite evidence catalog (default: data/catalog.db)
SQLITE_DB_PATH=data/catalog.db

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL) — for reference only, NOT for backend use
# Connection string used only for running migrations via psql or Supabase CLI.
# ---------------------------------------------------------------------------
# DB_HOST=db.your-project-ref.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
